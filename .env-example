# PageSquad AI Skills - Environment Variables Example
# Copy this file to .env and fill in your actual keys.
# Do NOT commit your actual .env file to version control.

# --- Visibility Architect ---
# Required for running the pagespeed-audit utility scripts
GOOGLE_API_KEY=your_google_api_key_here

# --- Automation Architect ---
# Required for the create-lead-sheet utility script (Google Sheets + Apps Script API)
# Option A: OAuth2 access token (obtain via: gcloud auth application-default login)
# Scopes needed: script.projects, spreadsheets, script.deployments, script.scriptapp
GOOGLE_OAUTH_TOKEN=your_google_oauth2_access_token_here

# Option B (alternative to above): Service account JSON key path or inline JSON
# The script auto-mints a JWT and exchanges it for a token — no manual token needed
# Create a service account at: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/your-service-account-key.json

# --- Automation Architect (Example Placeholders) ---
# Used for connecting CRM systems and webhooks
# HUBSPOT_API_KEY=your_hubspot_api_key_here
# ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...

# --- Insight Architect (Example Placeholders) ---
# Used for analytics and tracking validations
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# GTM_CONTAINER_ID=GTM-XXXXXX
# META_PIXEL_ID=XXXXXXXXXXXXXXX
# TIKTOK_PIXEL_ID=XXXXXXXXXXXXXXXXXXXX

# --- AI & Asset Generation (Example Placeholders) ---
# Common keys that might be used by Brand or Conversion architects
# OPENAI_API_KEY=sk-your_openai_api_key_here
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
